{
  "name": "laleh-discovery-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "measure:build": "node scripts/report-build-metrics.mjs",
    "benchmark:discovery": "node --experimental-strip-types scripts/benchmark-discovery.ts",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:ci": "node --experimental-strip-types --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=reports/web-tests.xml tests/*.test.ts",
    "validate:catalog": "node --experimental-strip-types scripts/validate-catalog.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
