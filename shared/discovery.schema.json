{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:laleh:public-discovery:v2",
  "title": "Approved public discovery metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groupId",
    "title",
    "username",
    "category",
    "location",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "groupId": {
      "type": "string",
      "pattern": "^-[1-9][0-9]{0,18}$",
      "description": "Negative signed 64-bit decimal ID; consumers must range-check."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "username": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{4,31}$"
    },
    "category": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "location": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Positive signed 64-bit decimal revision; consumers must range-check."
    }
  }
}
